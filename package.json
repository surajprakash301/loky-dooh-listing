{
  "name": "loky-media-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:sync": "node --env-file=.env.local --import tsx scripts/db-sync.ts",
    "db:seed": "node --env-file=.env.local --import tsx scripts/seed.ts",
    "db:reset": "npm run db:sync -- --force && npm run db:seed",
    "deploy:vercel": "bash scripts/deploy-vercel-neon.sh",
    "e2e": "node e2e/onboarding-flow.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "e2e:edge": "node e2e/auth-and-admin-edges.mjs && node e2e/rep-and-files-edges.mjs",
    "e2e:quote": "node e2e/quote-flow.mjs",
    "e2e:all": "npm run e2e && npm run e2e:edge && npm run e2e:agency && npm run e2e:quote",
    "e2e:agency": "node e2e/agency-flow.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@vercel/blob": "^2.9.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "jose": "^6.2.12",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.52.0",
    "mysql2": "^3.24.6",
    "next": "16.3.8",
    "pg": "^8.23.1",
    "pg-hstore": "^2.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sequelize": "^6.37.8",
    "shadcn": "^4.21.2",
    "supercluster": "^9.1.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/supercluster": "^7.1.3",
    "dotenv": "^18.0.8",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "playwright-core": "^1.50.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
